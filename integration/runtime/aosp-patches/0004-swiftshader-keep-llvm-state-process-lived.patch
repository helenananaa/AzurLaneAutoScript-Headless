diff --git a/src/Reactor/LLVMReactor.cpp b/src/Reactor/LLVMReactor.cpp
--- a/src/Reactor/LLVMReactor.cpp
+++ b/src/Reactor/LLVMReactor.cpp
@@ -27,7 +27,6 @@
 #include "llvm/IR/IntrinsicsX86.h"
 #include "llvm/Support/Alignment.h"
 #include "llvm/Support/Error.h"
-#include "llvm/Support/ManagedStatic.h"
 
 #include <fstream>
 #include <iostream>
@@ -61,8 +60,9 @@ using FixedVectorType = VectorType;
 
 namespace {
 
-// Used to automatically invoke llvm_shutdown() when driver is unloaded
-llvm::llvm_shutdown_obj llvmShutdownObj;
+// LLVM state is process-wide. Android can tear down one Vulkan client while
+// another client still has Reactor work in flight, so it must not be destroyed
+// when this driver instance is unloaded. The process reclaims it at exit.
 
 // This has to be a raw pointer because glibc 2.17 doesn't support __cxa_thread_atexit_impl
 // for destructing objects at exit. See crbug.com/1074222
@@ -2703,9 +2703,14 @@ RValue<Int4> RoundIntClamped(RValue<Float4> cast)
 	// 2147483520.0, so clamp to 2147483520. Values less than -2147483520.0
 	// saturate to 0x80000000.
 	return x86::cvtps2dq(Min(cast, Float4(0x7FFFFF80)));
+#elif(defined(__arm__) || defined(__aarch64__)) && LLVM_VERSION_MAJOR >= 14
+	// Use explicit saturating conversion on ARM/AArch64. Relying on target
+	// lowering for out-of-range values is not a portable LLVM IR contract.
+	llvm::Value *rounded = lowerRound(V(cast.value()));
+	llvm::Function *fptosi_sat = llvm::Intrinsic::getDeclaration(
+	    jit->module.get(), llvm::Intrinsic::fptosi_sat, { T(Int4::type()), T(Float4::type()) });
+	return RValue<Int4>(V(jit->builder->CreateCall(fptosi_sat, { rounded })));
 #elif defined(__arm__) || defined(__aarch64__)
-	// ARM saturates to the largest positive or negative integer. Unit tests
-	// verify that lowerRoundInt() behaves as desired.
 	return As<Int4>(V(lowerRoundInt(V(cast.value()), T(Int4::type()))));
 #elif LLVM_VERSION_MAJOR >= 14
 	llvm::Value *rounded = lowerRound(V(cast.value()));
diff --git a/third_party/llvm-16.0/llvm/lib/IR/PassRegistry.cpp b/third_party/llvm-16.0/llvm/lib/IR/PassRegistry.cpp
--- a/third_party/llvm-16.0/llvm/lib/IR/PassRegistry.cpp
+++ b/third_party/llvm-16.0/llvm/lib/IR/PassRegistry.cpp
@@ -19,8 +19,11 @@
 using namespace llvm;
 
 PassRegistry *PassRegistry::getPassRegistry() {
-  static PassRegistry PassRegistryObj;
-  return &PassRegistryObj;
+  // SwiftShader's Vulkan driver can be unloaded and loaded again while other
+  // process threads still use LLVM. Keep the registry and its mutex alive for
+  // the process lifetime instead of registering a DSO-scoped destructor.
+  static PassRegistry *PassRegistryObj = new PassRegistry();
+  return PassRegistryObj;
 }
 
