diff --git a/fonts.mk b/fonts.mk
--- a/fonts.mk
+++ b/fonts.mk
@@ -15,7 +15,20 @@
 # We have to use PRODUCT_PACKAGES (together with BUILD_PREBUILT) instead of
 # PRODUCT_COPY_FILES to install the font files, so that the NOTICE file can
 # get installed too.
 
+ifeq ($(TARGET_PRODUCT),redroid_x86_64_only)
+PRODUCT_PACKAGES += \
+    NotoColorEmoji.ttf \
+    NotoColorEmojiFlags.ttf \
+    NotoSansCJK-Regular.ttc \
+    NotoSansSymbols-Regular-Subsetted.ttf \
+    NotoSansSymbols-Regular-Subsetted2.ttf \
+    NotoSerif-Bold.ttf \
+    NotoSerif-BoldItalic.ttf \
+    NotoSerif-Italic.ttf \
+    NotoSerif-Regular.ttf
+else
+
 ifneq ($(RELEASE_REMOVE_LEGACY_EMOJI_FONT),true)
 # The legacy emoji font is always excluded from the wear OS.
 ifneq ($(CLOCKWORK_PRODUCT),true)
@@ -228,3 +241,4 @@ PRODUCT_PACKAGES := \
     NotoSerifThai-Regular.ttf \
     NotoSerifTibetan-VF.ttf \
     NotoSerifYezidi-VF.ttf
+endif
