+    private fun deterministicGenerationHash(command: CommandOptions): Int {
+        val digest = MessageDigest.getInstance("SHA-256")
+        digest.update(command.protoLogClassNameArg.toByteArray())
+        digest.update(0.toByte())
+        digest.update(command.protoLogGroupsClassNameArg.toByteArray())
+        command.javaSourceArgs
+            .map { path ->
+                MessageDigest.getInstance("SHA-256")
+                    .digest(injector.readText(File(path)).toByteArray())
+                    .joinToString("") { byte -> "%02x".format(byte) }
+            }
+            .sorted()
+            .forEach { sourceDigest ->
+                digest.update(0.toByte())
+                digest.update(sourceDigest.toByteArray())
+            }
+        return digest.digest().take(4).fold(0) { value, byte ->
+            (value shl 8) or (byte.toInt() and 0xff)
+        } and Int.MAX_VALUE
+    }
