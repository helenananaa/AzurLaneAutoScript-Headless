+
+# A narrow Goldfish phone product for the externally installed Azur Lane,
+# ANGLE NULL observer, and ALAS adapter runtime.  The first slimming stage
+# removes generic phone applications while retaining the Android surfaces
+# required for installation, WebView login, recovery, and typed automation.
+
+PRODUCT_USE_DYNAMIC_PARTITIONS := true
+
+# Preserve the qualified emu64x partition envelope during the first stage.
+# It is intentionally reduced only after real image-size and rollback proof.
+BOARD_SUPER_PARTITION_SIZE ?= 1619001344
+BOARD_EMULATOR_DYNAMIC_PARTITIONS_SIZE ?= 1610612736
+
+# /system: retain the standard Android framework, security, networking,
+# storage, media, and Goldfish compatibility substrate.  KVM-only exclusions
+# are narrowly scoped in the pinned build/make patch.
+$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit_only.mk)
+$(call inherit-product, $(SRC_TARGET_DIR)/product/generic_system.mk)
+
+ifeq (alas_kvm_x86_64,$(TARGET_PRODUCT))
+PRODUCT_ENFORCE_ARTIFACT_PATH_REQUIREMENTS := relaxed
+endif
+
+# /system_ext: keep the real recovery and system-dialog surfaces.  Do not use
+# sdk_slim's FakeSystemApp or disabled-HWUI overlay.
+$(call inherit-product, $(SRC_TARGET_DIR)/product/media_system_ext.mk)
+PRODUCT_PACKAGES += \
+    CarrierConfig \
+    Launcher3QuickStep \
+    Provision \
+    Settings \
+    StorageManager \
+    SystemUI \
+
+# /product: retain WebView, input, settings intelligence, and the Goldfish
+# resource overlays; omit generic consumer applications and default media.
+$(call inherit-product, $(SRC_TARGET_DIR)/product/media_product.mk)
+PRODUCT_PACKAGES += \
+    LatinIME \
+    preinstalled-packages-platform-handheld-product.xml \
+    SettingsIntelligence \
+    frameworks-base-overlays \
+    GoldfishSkinConfig \
+
+PRODUCT_PACKAGES_DEBUG += \
+    frameworks-base-overlays-debug \
+
+PRODUCT_SDK_ADDON_SYS_IMG_SOURCE_PROP := \
+    development/sys-img/images_x86_64_source.prop_template
+
+# /vendor: keep the fully qualified Goldfish/KVM hardware boundary.
+$(call inherit-product, device/generic/goldfish/board/emu64x/details.mk)
+$(call inherit-product, device/generic/goldfish/64bitonly/product/emulator64_vendor.mk)
+
+# The project intentionally builds userdebug while ANGLE routing, observer
+# installation, and failure diagnosis still require that surface.
+PRODUCT_BROKEN_VERIFY_USES_LIBRARIES := true
+PRODUCT_BRAND := Android
+PRODUCT_NAME := alas_kvm_x86_64
+PRODUCT_DEVICE := emu64x
+PRODUCT_MODEL := ALAS Headless KVM x86_64
