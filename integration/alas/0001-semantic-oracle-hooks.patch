index cd88c16282b4f6c8bcf9eac2202e836797869e3c..efa9500e8b5c759653038f4867dbf2f365269384 100644
--- a/module/commission/project.py
+++ b/module/commission/project.py
@@ -106,6 +106,58 @@ class Commission:
     # Value: 1:30, 1:45, 2:00, 8:00, 12:00, ...
     duration_hm: str
 
+    @classmethod
+    def from_semantic(cls, state, config, list_mode):
+        """Build the normal ALAS commission model from one typed Unity row."""
+        if list_mode not in ('daily', 'urgent'):
+            raise ValueError('Unknown semantic commission list mode')
+        self = cls.__new__(cls)
+        self.config = config
+        self.name = state.name
+        self.duration = timedelta(seconds=state.duration_seconds)
+        self.expire = timedelta(seconds=0)
+        self.status = state.status.value
+        self.valid = True
+        self.semantic_signature = state.signature
+        self.semantic_row_key = (list_mode, state.index)
+        self.genre = self.commission_name_parse(self.name)
+        if not self.genre:
+            self.valid = False
+        self.suffix_image = None
+        self.suffix_hash = ''
+        self.repeat_count = 1
+        self.create_time = datetime.now()
+        self.category_str = 'unknown'
+        self.genre_str = 'unknown'
+        self.duration_hour = 'unknown'
+        self.duration_hm = 'unknown'
+        if self.valid:
+            self.category_str, self.genre_str = self.genre.split('_', 1)
+            self.duration_hour = str(
+                int(self.duration.total_seconds() / 36) / 100).strip('.0')
+            self.duration_hm = str(self.duration).rsplit(':', 1)[0]
+
+        bounds = state.button.bounds
+        if bounds is None:
+            self.valid = False
+            area = (0, 0, 0, 0)
+        else:
+            area = tuple(int(round(value)) for value in (
+                bounds.left, bounds.top, bounds.right, bounds.bottom))
+        self.area = area
+        self.y = area[3]
+        self.image = None
+        self.button = Button(
+            area=area,
+            color=(),
+            button=area,
+            name=f'COMMISSION_ROW_{state.index}',
+        )
+        self.button.semantic_commission_signature = state.signature
+        self.semantic_level = state.level
+        self.semantic_type_sprite = state.type_sprite
