diff --git a/module/meowfficer/train.py b/module/meowfficer/train.py
index ccdda576..cc81df14 100644
--- a/module/meowfficer/train.py
+++ b/module/meowfficer/train.py
@@ -196,6 +196,33 @@ class MeowfficerTrain(MeowfficerCollect, MeowfficerEnhance):
         """
         logger.hr('Meowfficer train', level=1)
 
+        semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+        if semantic_adapter is not None:
+            dock = semantic_adapter.meowfficer_dock_state()
+            self._box_count = list(dock.box_counts)
+            self.meow_enter(
+                MEOWFFICER_TRAIN_ENTER,
+                check_button=MEOWFFICER_TRAIN_START,
+            )
+            training = semantic_adapter.meowfficer_training_state()
+            occupied = training.active_training + training.waiting
+            capacity = training.active_capacity + training.waiting_capacity
+            if training.completed == 0 and occupied >= capacity:
+                logger.info('Meowfficer training queue is full, stopped')
+                self.meow_menu_close()
+                return False
+            logger.attr('MeowfficerTrain_Mode', self.config.MeowfficerTrain_Mode)
+            collected = False
+            if dock.capacity_used < dock.capacity_total:
+                collect_all = (
+                    self.config.MeowfficerTrain_Mode == 'seamlessly'
+                    or self.meow_is_sunday()
+                )
+                collected = self.meow_collect(collect_all=collect_all)
+            self.meow_queue(ascending=False)
+            self.meow_menu_close()
+            return collected
+
         # Retrieve capacity to determine whether able to collect
         current, remain, total = MEOWFFICER_CAPACITY.ocr(self.device.image)
         logger.attr('Meowfficer_capacity_remain', remain)
