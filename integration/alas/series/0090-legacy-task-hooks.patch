+                                    sortie_clicked = True
+                        finally:
+                            if not sortie_clicked:
+                                try:
+                                    semantic_adapter.close_campaign_fleet_dropdown_for_rollback()
+                                finally:
+                                    self.enter_map_cancel()
+                        if sortie_clicked:
+                            continue
+                        if fleet_authorized:
+                            proof = semantic_adapter.confirm_campaign_fleet_preparation()
+                            logger.info(
+                                f'Semantic campaign fleet-preparation proof: '
+                                f'{proof.stage_code}, {proof.initial_fleets}'
+                                f'->{proof.prepared_fleets}, '
+                                f'mutations={proof.mutation_semantic_ids}, '
+                                f'{proof.cancel_generation}'
+                                f'->{proof.restored_generation}'
+                            )
+                        else:
+                            proof = semantic_adapter.confirm_campaign_pre_sortie()
+                            logger.info(
+                                f'Semantic campaign pre-sortie proof: '
+                                f'{proof.stage_code}, {proof.preparation_kind}, '
+                                f'{proof.entry_generation}'
+                                f'->{proof.cancel_generation}'
+                                f'->{proof.restored_generation}'
+                            )
+                        raise ScriptEnd(
+                            'Semantic campaign pre-sortie validation complete'
+                        )
+                    if self.appear(MAP_PREPARATION, offset=(20, 20)):
+                        self.handle_auto_search()
+                        self.device.click(MAP_PREPARATION)
+                        map_click += 1
+                        map_timer.reset()
+                        campaign_timer.reset()
+                        continue
+                    # A semantic observation can advance between two appear()
+                    # calls.  Once map preparation is committed, never let an
+                    # unhandled transition generation fall through to the
+                    # original fleet/sortie input branches below.  Earlier
+                    # ALAS navigation and recovery states remain unchanged.
+                    if semantic_adapter.campaign_map_preparation_committed():
+                        continue
+
                 # Accidental clicks
                 if self.appear(DAILY_CHECK, offset=(20, 20), interval=3):
                     logger.info(f'{DAILY_CHECK} -> {BACK_ARROW}')
