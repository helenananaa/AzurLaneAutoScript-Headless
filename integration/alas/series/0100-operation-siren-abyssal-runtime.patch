diff --git a/module/os_handler/map_event.py b/module/os_handler/map_event.py
index a011d092..53fb10d9 100644
--- a/module/os_handler/map_event.py
+++ b/module/os_handler/map_event.py
@@ -354,7 +354,19 @@ class MapEventHandler(EnemySearchingHandler):
         """
         # Fleet lock depends on if it appear on map, not depends on map status.
         # Because if already in map, there's no map status,
-        if not fleet_lock.appear(main=self):
+        semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+        if semantic_adapter is not None:
+            from alas_headless import SemanticGateClosed
+            try:
+                fleet_lock_visible = fleet_lock.appear(main=self)
+            except SemanticGateClosed:
+                # Abyssal and other locked special rooms legitimately omit
+                # the fleet-lock toggle.  Its exact semantic absence means
+                # there is nothing to switch.
+                fleet_lock_visible = False
+        else:
+            fleet_lock_visible = fleet_lock.appear(main=self)
+        if not fleet_lock_visible:
             logger.info('No fleet lock option.')
             return False
 
diff --git a/module/os_handler/port.py b/module/os_handler/port.py
index ff27df84..d2d72e97 100644
--- a/module/os_handler/port.py
+++ b/module/os_handler/port.py
@@ -127,6 +127,54 @@ class PortHandler(OSShop):
             in: PORT_CHECK
             out: PORT_CHECK
         """
+        semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+        if semantic_adapter is not None:
+            logger.info('Port dock repair (typed)')
+            from alas_headless import SemanticGateClosed
+            oracle = semantic_adapter.open().oracle
+            if oracle.enabled('os/port/dock'):
+                oracle.click('os/port/dock')
+                self.device.sleep(0.5)
+
+            attempted = False
+            repaired = False
+            for _ in range(24):
+                cost = semantic_adapter.operation_siren_port_repair_cost()
+                if cost is not None:
+                    logger.attr('PortRepairCost', cost)
+                    semantic_adapter.click_operation_siren_port_repair(True)
+                    repaired = True
+                    self.device.sleep(0.5)
+                    continue
+                if oracle.enabled('os/port/dock/repair-all'):
+                    if attempted or repaired:
+                        break
+                    oracle.click('os/port/dock/repair-all')
+                    attempted = True
+                    self.device.sleep(0.5)
+                    continue
+                self.device.sleep(0.25)
+            else:
+                raise RuntimeError('Typed port repair did not settle')
+
+            for _ in range(24):
+                if oracle.enabled('os/port/supply'):
+                    return
+                # The dock back control can remain mounted while its first
+                # click is swallowed by the repair-panel closing animation.
+                # Re-read the exact control and retry until the port buttons
+                # are positively visible.
+                if oracle.exists('os/port/dock/back'):
+                    try:
+                        oracle.click('os/port/dock/back')
+                    except SemanticGateClosed:
+                        self.device.sleep(0.25)
+                        continue
+                    self.device.sleep(0.5)
+                    continue
+                self.device.sleep(0.25)
+            raise RuntimeError('Typed port repair did not return to port')
+
         self.ui_click(PORT_GOTO_DOCK, appear_button=PORT_CHECK, check_button=PORT_DOCK_CHECK,
                       skip_first_screenshot=True)
 
