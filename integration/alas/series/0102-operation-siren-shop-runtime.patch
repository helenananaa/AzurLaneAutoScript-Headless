diff --git a/module/os_handler/port.py b/module/os_handler/port.py
index d2d72e9..136f664 100644
--- a/module/os_handler/port.py
+++ b/module/os_handler/port.py
@@ -1,3 +1,5 @@
+from alas_headless import SemanticGateClosed
+
 from module.base.timer import Timer
 from module.logger import logger
 from module.os_handler.assets import *
@@ -95,6 +97,24 @@ class PortHandler(OSShop):
             in: PORT_CHECK
             out: PORT_SUPPLY_CHECK
         """
+        semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+        if semantic_adapter is not None:
+            oracle = semantic_adapter.open().oracle
+            try:
+                semantic_adapter.operation_siren_shop_items()
+                return
+            except SemanticGateClosed:
+                pass
+            semantic_adapter.refresh_frame()
+            oracle.click('os/port/supply')
+            for _ in range(24):
+                self.device.sleep(0.5)
+                try:
+                    semantic_adapter.operation_siren_shop_items()
+                    return
+                except SemanticGateClosed:
+                    continue
+            raise RuntimeError('Typed Operation Siren shop did not open')
         if self.appear(PORT_SUPPLY_CHECK, offset=(20, 20)):
             return
