+from alas_headless import SemanticOracleError
+
 from module.base.timer import Timer
 from module.base.utils import *
 from module.logger import logger
@@ -397,7 +399,29 @@ class GlobeOperation(ActionPointHandler):
                 if self.handle_action_point(zone=zone, pinned=pinned):
                     # The AP panel dismisses the selected-zone float panel.
