+        from alas_headless import current_semantic_session
+        semantic_session = current_semantic_session()
+        if semantic_session is not None:
+            # ALAS retains task scheduling and the detailed Enhance config.
+            # The semantic port owns Dock filtering, target navigation, the
+            # official recommendation, the single destructive confirmation,
+            # and the observed material count.  Invalid filter tokens fail
+            # closed instead of entering the legacy random-type fallback.
+            ship_to_enhance = self.config.Enhance_ShipToEnhance
