+                ship_to_enhance = 'favourite' if favourite else 'all'
+            return semantic_session.enhance_ships(
+                ship_to_enhance=ship_to_enhance,
+                check_per_category=self.config.Enhance_CheckPerCategory,
+                filter_expression=self.config.Enhance_Filter,
+            )
+
         if favourite is None:
             favourite = self.config.Enhance_ShipToEnhance == 'favourite'
 
