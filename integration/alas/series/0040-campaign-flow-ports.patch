+                    area=area,
+                    color=(0, 0, 0),
+                    button=area,
+                    name=stage.stage_code,
+                )
+                button.semantic_campaign_stage_code = stage.stage_code
+                self.stage_entrance[stage.stage_code] = button
+            logger.attr('Chapter', self.campaign_chapter)
+            logger.attr('Stage', ', '.join(self.stage_entrance.keys()))
+            return
+
         self.stage_entrance = {}
         del_cached_property(self, '_stage_image')
         del_cached_property(self, '_stage_image_gray')
