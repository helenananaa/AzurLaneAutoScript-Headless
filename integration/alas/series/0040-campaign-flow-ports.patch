+        from alas_headless import current_semantic_session
+        semantic_session = current_semantic_session()
+        if semantic_session is not None:
+            state = semantic_session.campaign_page_state()
+            # Semantic stage codes are the canonical ALAS names.  Main stages
+            # contain a dash (``12-4``), while event stages do not (``a1``).
+            # Splitting on a dash therefore turns ``a1`` into a bogus chapter
