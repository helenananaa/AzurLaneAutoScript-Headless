diff --git a/alas.py b/alas.py
index e0e52437..96ba4292 100644
--- a/alas.py
+++ b/alas.py
@@ -553,5 +553,10 @@ class AzurLaneAutoScript:
             self.device.click_record_clear()
             logger.hr(task, level=0)
-            success = self.run(inflection.underscore(task))
+            # Restart owns the lifecycle that makes a first screenshot
+            # possible.  Do not require an already-running game before its
+            # LoginHandler.app_restart() can stop, launch, and log in again.
+            success = self.run(
+                inflection.underscore(task), skip_first_screenshot=(task == 'Restart')
+            )
             logger.info(f'Scheduler: End task `{task}`')
             self.is_first_task = False
