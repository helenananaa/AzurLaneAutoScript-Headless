+                        if semantic_phase == 'precombat':
+                            if semantic_notice_acknowledged:
+                                raise ScriptError('Current Raid notice reappeared')
+                            semantic_adapter.click_raid_precombat_notice(event=raid)
+                            semantic_notice_acknowledged = True
+                            semantic_phase = 'precombat-notice-dismissed'
+                            transition_timeout.reset()
+                            continue
+                    elif semantic_adapter.raid_precombat_visible(event=raid):
