+                        ):
+                            raise ScriptError(
+                                'Current Raid zero-ticket multiple-sortie state '
+                                'is inconsistent'
+                            )
+                        semantic_adapter.click_raid_multiple_sortie_back(event=raid)
+                        semantic_phase = 'multiple-sortie-closed'
+                        transition_timeout.reset()
+                        continue
+                elif semantic_phase in (
