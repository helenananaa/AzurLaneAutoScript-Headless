+                            semantic_adapter.click_raid_precombat_multiple(event=raid)
+                            semantic_phase = 'multiple-sortie'
+                        else:
+                            semantic_adapter.click_raid_precombat_start(event=raid)
+                            semantic_phase = 'battle-loading'
+                        transition_timeout.reset()
+                        continue
+                    elif (
+                        semantic_phase == 'precombat-notice-dismissed'
+                        and semantic_adapter.raid_page_visible(event=raid)
+                    ):
+                        if semantic_notice_reentry_used:
+                            raise ScriptError('Current Raid notice re-entry repeated')
+                        semantic_notice_reentry_used = True
+                        semantic_phase = 'raid-page'
+                        transition_timeout.reset()
+                        continue
+
+                # Every semantic input above is single-dispatch.  A stalled
