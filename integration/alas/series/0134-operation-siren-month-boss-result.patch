@@ -453,6 +453,22 @@ class Combat(Level, HPBalancer, Retirement, SubmarineCall, CombatAuto, CombatMan
         """
         if self.is_combat_executing():
             return False
+        semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+        if (
+            semantic_adapter is not None
+            and semantic_adapter.operation_siren_combat_committed()
+            and semantic_adapter.operation_siren_battle_result_visible()
+        ):
+            grade = semantic_adapter.operation_siren_battle_result_grade()
+            if drop:
+                drop.handle_add(self)
+            else:
+                self.device.sleep((0.25, 0.5))
+            semantic_adapter.click_operation_siren_battle_result()
+            if grade == 'DEFEAT':
+                logger.warning('Battle Status D')
+                semantic_adapter.mark_operation_siren_combat_fleet_defeated()
+            return True
         if self.appear(BATTLE_STATUS_S, interval=self.battle_status_click_interval):
             if drop:
                 drop.handle_add(self)
