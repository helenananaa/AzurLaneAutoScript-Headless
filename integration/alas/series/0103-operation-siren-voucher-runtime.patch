+    def _semantic_voucher_item_to_buy(self, records, balance):
+        """Apply the original ordered filter to typed, voucher-cost records."""
+
+        FILTER.load(self.shop_filter)
+        parsed = []
+        for record in records:
+            match = FILTER_REGEX.fullmatch(record.canonical_name)
+            if match is None:
+                continue
+            parsed.append((record, tuple(
+                value.lower() if value is not None else None
+                for value in match.groups()
+            )))
+        for wanted in FILTER.filter:
+            for record, actual in parsed:
+                if any(
+                    value is not None and value != candidate
+                    for value, candidate in zip(wanted, actual)
+                ):
+                    continue
+                if (
+                    record.currency == 'Voucher'
+                    and not record.sold_out
+                    and record.remaining > 0
+                    and record.price <= balance
+                ):
+                    return record
+        return None
+
