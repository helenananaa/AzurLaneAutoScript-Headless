@@ -20,6 +20,16 @@ class PortHandler(OSShop):
             out: PORT_CHECK
         """
         logger.info('Port enter')
+        semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+        if semantic_adapter is not None:
+            semantic_adapter.refresh_frame()
+            semantic_adapter.open().oracle.click('os/port/enter')
+            for _ in range(24):
+                self.device.sleep(0.5)
