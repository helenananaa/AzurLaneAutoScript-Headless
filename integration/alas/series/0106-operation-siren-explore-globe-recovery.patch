From 56e81ffb4bff7776d53fba28295ae52f1e9ee323 Mon Sep 17 00:00:00 2001
From: ALAS Patch Builder <alas-patch-builder@example.invalid>
Date: Fri, 21 Aug 2026 18:44:12 +0800
Subject: [PATCH] operation siren explore globe recovery

---
 module/os/globe_camera.py    | 49 +++++++++++++++++++++---------------
 module/os/globe_operation.py |  5 ++++
 module/os/map.py             | 25 ++++++++++++++++--
 3 files changed, 57 insertions(+), 22 deletions(-)

diff --git a/module/os/globe_camera.py b/module/os/globe_camera.py
index eee79868..4b16a95e 100644
--- a/module/os/globe_camera.py
+++ b/module/os/globe_camera.py
@@ -262,6 +262,8 @@ class GlobeCamera(GlobeOperation, ZoneManager):
         semantic_adapter = getattr(self.device, 'semantic_adapter', None)
         if semantic_adapter is not None:
             sight = (20, 220, 980, 620)
+            previous_anchor_name = None
+            anchor_repeat_count = 0
             for focus_attempt in range(16):
                 try:
                     state = semantic_adapter.operation_siren_globe_state()
@@ -275,6 +277,11 @@ class GlobeCamera(GlobeOperation, ZoneManager):
                 # The exact selected-zone name and the fixed typed panel pin
                 # anchor the ALAS globe camera without screenshot matching.
                 if state is not None:
+                    if state.zone_name == previous_anchor_name:
+                        anchor_repeat_count += 1
+                    else:
+                        previous_anchor_name = state.zone_name
+                        anchor_repeat_count = 0
                     self.globe_update()
                     try:
                         receipt = semantic_adapter.operation_siren_globe_unpin()
@@ -292,19 +299,9 @@ class GlobeCamera(GlobeOperation, ZoneManager):
                     self.globe_camera = tuple(
                         selected.location - pinned_globe + self.globe.homo_center
                     )
-                    if self.config.DEVICE_CONTROL_METHOD == 'minitouch':
-                        distance = self.config.MAP_SWIPE_MULTIPLY_MINITOUCH
-                    elif self.config.DEVICE_CONTROL_METHOD == 'MaaTouch':
-                        distance = self.config.MAP_SWIPE_MULTIPLY_MAATOUCH
-                    else:
-                        distance = self.config.MAP_SWIPE_MULTIPLY
-                    pixel_delta = np.subtract(receipt.end, receipt.start)
-                    unpin_vector = -pixel_delta / np.array(distance, dtype=float)
-                    self.globe_camera = tuple(
-                        np.array(self.globe_camera, dtype=float)
-                        + unpin_vector
-                        * np.array(self.config.OS_GLOBE_SWIPE_MULTIPLY)
-                    )
+                    # The selected panel re-centers its typed pin before the
+                    # dismissal drag; do not count that UI gesture as an ALAS
+                    # globe-camera move until live evidence proves otherwise.
                 elif not hasattr(self, 'globe_camera'):
                     raise GameStuckError(
                         'Semantic globe has no selected-zone camera anchor'
@@ -336,14 +333,14 @@ class GlobeCamera(GlobeOperation, ZoneManager):
                 target = self.globe2screen([zone.location])[0] + (8, -5)
                 # A proven unpin drag also moves the globe camera.  The
                 # configured swipe multiplier is close but not exact on
-                # every emulator, so probe a deterministic tight spiral
-                # around ALAS' projected anchor.  Eight-pixel spacing is
-                # needed where a normal zone lies between two port pins.
+                # every emulator, so probe a deterministic sparse spiral
+                # around ALAS' projected anchor.  A mismatch immediately
+                # supplies a stronger typed anchor for the next attempt.
                 probe_offsets = tuple(sorted(
                     (
                         (x, y)
-                        for x in range(-64, 65, 8)
-                        for y in range(-64, 65, 8)
+                        for x in range(-160, 161, 32)
+                        for y in range(-160, 161, 32)
                     ),
                     key=lambda point: (
                         max(abs(point[0]), abs(point[1])),
@@ -352,8 +349,20 @@ class GlobeCamera(GlobeOperation, ZoneManager):
                         point[0],
                     ),
                 ))
-                shift = focus_attempt * 17 % len(probe_offsets)
-                probe_offsets = probe_offsets[shift:] + probe_offsets[:shift]
+                # A mismatch supplies a fresh exact typed anchor.  Retry the
+                # recalibrated projection once.  If that exact point selects
+                # the same neighboring zone again, rotate through recovery
+                # points instead of getting trapped on that pin forever.
+                center_offset = probe_offsets[0]
+                recovery_offsets = probe_offsets[1:]
+                shift = focus_attempt * 17 % len(recovery_offsets)
+                rotated_recovery = (
+                    recovery_offsets[shift:] + recovery_offsets[:shift]
+                )
+                if anchor_repeat_count == 0:
+                    probe_offsets = (center_offset,) + rotated_recovery
+                else:
+                    probe_offsets = rotated_recovery + (center_offset,)
                 selected_mismatch = False
                 for offset in probe_offsets:
                     probe = target + offset
diff --git a/module/os/globe_operation.py b/module/os/globe_operation.py
index 02876ef5..a40ce2c8 100644
--- a/module/os/globe_operation.py
+++ b/module/os/globe_operation.py
@@ -105,6 +105,11 @@ class GlobeOperation(ActionPointHandler):
             return False
 
         if self.is_zone_pinned():
+            semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+            if semantic_adapter is not None:
+                semantic_adapter.operation_siren_globe_unpin()
+                self._zone_unpin_interval.reset()
+                return True
             # A click does not disable pinned zone, a swipe does.
             self.device.swipe_vector(
                 (50, -50), box=area_pad(ZONE_PINNED.area, pad=-80), random_range=(-10, -10, 10, 10),
diff --git a/module/os/map.py b/module/os/map.py
index 5183198f..f12eaa82 100644
--- a/module/os/map.py
+++ b/module/os/map.py
@@ -217,12 +217,33 @@ class OSMap(OSFleet, Map, GlobeCamera, StrategicSearchHandler):
             self.os_map_goto_globe()
         # IN_GLOBE
         # self.ensure_no_zone_pinned()
-        self.globe_update()
+        semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+        if (
+            semantic_adapter is not None
+            and getattr(self, '_semantic_globe_camera_unpinned', False)
+        ):
+            if not hasattr(self, 'globe_camera'):
+                raise SemanticGateClosed(
+                    'semantic globe camera disappeared after typed unpin'
+                )
+            self._semantic_globe_camera_unpinned = False
+            logger.info(
+                'Reuse proven semantic globe camera after typed zone unpin'
+            )
+        else:
+            self.globe_update()
         self.globe_focus_to(zone)
         if stop_if_safe:
             if self.zone_has_safe():
                 logger.info('Zone is safe, stopped')
-                self.ensure_no_zone_pinned()
+                semantic_adapter = getattr(
+                    self.device, 'semantic_adapter', None
+                )
+                if semantic_adapter is not None:
+                    semantic_adapter.operation_siren_globe_unpin()
+                    self._semantic_globe_camera_unpinned = True
+                else:
+                    self.ensure_no_zone_pinned()
                 return False
         self.zone_type_select(types=types)
         self.globe_enter(zone)
-- 
