From 35d32a345c0bb1514e5bdb8abf22b1bbc0a5fb7e Mon Sep 17 00:00:00 2001
From: ALAS Patch Builder <alas-patch-builder@example.invalid>
Date: Fri, 21 Aug 2026 19:53:22 +0800
Subject: [PATCH] operation siren explore inventory and anchor recovery

---
 module/os/globe_camera.py    | 32 ++++++++++++++++++++++++++++----
 module/os_handler/storage.py | 13 ++++++++++++-
 2 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/module/os/globe_camera.py b/module/os/globe_camera.py
index 4b16a95e..967a3e05 100644
--- a/module/os/globe_camera.py
+++ b/module/os/globe_camera.py
@@ -264,6 +264,7 @@ class GlobeCamera(GlobeOperation, ZoneManager):
             sight = (20, 220, 980, 620)
             previous_anchor_name = None
             anchor_repeat_count = 0
+            global_recovery = False
             for focus_attempt in range(16):
                 try:
                     state = semantic_adapter.operation_siren_globe_state()
@@ -277,6 +278,7 @@ class GlobeCamera(GlobeOperation, ZoneManager):
                 # The exact selected-zone name and the fixed typed panel pin
                 # anchor the ALAS globe camera without screenshot matching.
                 if state is not None:
+                    global_recovery = False
                     if state.zone_name == previous_anchor_name:
                         anchor_repeat_count += 1
                     else:
@@ -363,9 +365,25 @@ class GlobeCamera(GlobeOperation, ZoneManager):
                     probe_offsets = (center_offset,) + rotated_recovery
                 else:
                     probe_offsets = rotated_recovery + (center_offset,)
+                if global_recovery:
+                    probe_points = tuple(sorted(
+                        (
+                            (x, y)
+                            for x in range(100, 901, 160)
+                            for y in range(260, 581, 80)
+                        ),
+                        key=lambda point: (
+                            abs(point[0] - 500) + abs(point[1] - 420),
+                            point[1],
+                            point[0],
+                        ),
+                    ))
+                else:
+                    probe_points = tuple(
+                        target + offset for offset in probe_offsets[:16]
+                    )
                 selected_mismatch = False
-                for offset in probe_offsets:
-                    probe = target + offset
+                for probe in probe_points:
                     if not point_in_area(probe, area=sight):
                         continue
                     try:
@@ -384,9 +402,15 @@ class GlobeCamera(GlobeOperation, ZoneManager):
                     selected_mismatch = True
                     break
                 if not selected_mismatch:
-                    raise GameStuckError(
-                        'Semantic globe could not recover a selected zone'
+                    if global_recovery:
+                        raise GameStuckError(
+                            'Semantic globe could not recover a selected zone'
+                        )
+                    logger.warning(
+                        'Semantic target probes were empty; discover a global '
+                        'typed zone anchor'
                     )
+                    global_recovery = True
             raise GameStuckError('Semantic globe could not select the expected zone')
 
         while 1:
diff --git a/module/os_handler/storage.py b/module/os_handler/storage.py
index 8d3868ec..5e5516ad 100644
--- a/module/os_handler/storage.py
+++ b/module/os_handler/storage.py
@@ -1,4 +1,4 @@
-from alas_headless import validate_alas_opsi_storage_config
+from alas_headless import SemanticGateClosed, validate_alas_opsi_storage_config
 
 from module.base.timer import Timer
 from module.base.utils import rgb2gray
@@ -156,6 +156,17 @@ class StorageHandler(GlobeOperation, ZoneManager):
             in: STORAGE_CHECK
             out: STORAGE_CHECK, scroll to bottom
         """
+        semantic_adapter = getattr(self.device, 'semantic_adapter', None)
+        if semantic_adapter is not None:
+            state = semantic_adapter.operation_siren_storage_state()
+            logger.attr('Storage_sample', state.sample_count)
+            if state.sample_count:
+                raise SemanticGateClosed(
+                    'typed tuning sample consumption is not qualified'
+                )
+            logger.info('All samples in storage have been used')
+            return
+
         sample_types = [
             TEMPLATE_STORAGE_OFFENSE, TEMPLATE_STORAGE_SURVIVAL, TEMPLATE_STORAGE_COMBAT,
             TEMPLATE_STORAGE_QUALITY_OFFENSE, TEMPLATE_STORAGE_QUALITY_SURVIVAL, TEMPLATE_STORAGE_QUALITY_COMBAT
